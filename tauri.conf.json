{
  "build": {
    "target": "x86_64-pc-windows-msvc",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis", "app"],
      "identifier": "com.jarvis.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    }
  },
  "tauri": {
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": true,
        "execute": true,
        "sidecar": true
      },
      "filesystem": {
        "all": true,
        "readFile": true,
        "writeFile": true
      },
      "notification": {
        "all": true
      }
    },
    "windows": [
      {
        "title": "JARVIS Personal Assistant",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ]
  }
}
