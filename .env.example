# JARVIS Core Environment Configuration Example
# Copy to .env for local overrides

JARVIS_ENV=development
LOG_LEVEL=info

# AI Providers (Optional for local mocks, required for live cloud routing)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Local Model Runtimes
OLLAMA_BASE_URL=http://localhost:11434

# Vector Memory Configuration
MEMORY_ACTIVATION_THRESHOLD=0.72
MEMORY_SUPPRESSION_THRESHOLD=0.50

# Approval Engine Configuration
DEFAULT_REQUIRE_APPROVAL_RISK_THRESHOLD=4
